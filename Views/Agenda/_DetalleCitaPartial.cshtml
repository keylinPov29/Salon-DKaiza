@model DKaiza.Web.Estilistas.DetalleCitaDto
@using DKaiza.Web.Dominio

@{
    string ClaseEstado(EstadoCita e) => e switch
    {
        EstadoCita.Pendiente     => "st-pendiente",
        EstadoCita.Confirmada    => "st-confirmada",
        EstadoCita.PendientePago => "st-pago",
        EstadoCita.Pagada        => "st-pagada",
        EstadoCita.EnProceso     => "st-proceso",
        EstadoCita.Completada    => "st-completada",
        EstadoCita.Cancelada     => "st-cancelada",
        _ => "st-pendiente"
    };

    string TextoEstado(EstadoCita e) => e switch
    {
        EstadoCita.Pendiente     => "Pendiente",
        EstadoCita.Confirmada    => "Confirmada",
        EstadoCita.PendientePago => "Pendiente de pago",
        EstadoCita.Pagada        => "Pagada",
        EstadoCita.EnProceso     => "En proceso",
        EstadoCita.Completada    => "Completada",
        EstadoCita.Cancelada     => "Cancelada",
        _ => e.ToString()
    };

    var esAdmin = User.IsInRole("Administrador");
    var esEstilista = User.IsInRole("Estilista");

    // Una cita con pago pendiente NO se puede iniciar
    var pagoPendiente = Model.Estado == EstadoCita.PendientePago;
    var puedeIniciar = Model.Estado == EstadoCita.Pendiente
                    || Model.Estado == EstadoCita.Pagada
                    || Model.Estado == EstadoCita.Confirmada;

    var mostrarTel = !string.IsNullOrWhiteSpace(Model.ClienteTelefono) && Model.ClienteTelefono != "N/A";
}

<style>
    .dc-header {
        position: relative; text-align: center; padding: 24px 24px 22px; color: #fff;
        background: linear-gradient(135deg, #b88f86, #9c766d);
    }
    .dc-header::after {
        content: ''; position: absolute; top: -50px; right: -40px; width: 150px; height: 150px;
        border-radius: 50%; background: rgba(255,255,255,.12); pointer-events: none;
    }
    .dc-eyebrow { font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; opacity: .85; font-weight: 600; }
    .dc-header h4 { margin: 4px 0 12px; font-family: 'Playfair Display', serif; font-weight: 600; font-size: 1.4rem; }
    .dc-cerrar {
        position: absolute; top: 14px; right: 14px; z-index: 2; width: 32px; height: 32px; border-radius: 50%;
        background: rgba(255,255,255,.18); border: none; color: #fff; font-size: .9rem; cursor: pointer;
        transition: background-color .2s, transform .25s;
    }
    .dc-cerrar:hover { background: rgba(255,255,255,.32); transform: rotate(90deg); }

    .dc-badge {
        position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 6px;
        font-size: .72rem; font-weight: 700; padding: 5px 13px; border-radius: 999px; background: #fff;
    }
    .dc-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .dc-badge.st-pendiente  { color: #8f5f36; }
    .dc-badge.st-confirmada { color: #476080; }
    .dc-badge.st-pago       { color: #9a5048; }
    .dc-badge.st-pagada     { color: #36684b; }
    .dc-badge.st-proceso    { color: #7d5a50; }
    .dc-badge.st-completada { color: #36684b; }
    .dc-badge.st-cancelada  { color: #7a6a68; }

    .dc-body { background: #faf6f4; padding: 8px 26px 6px; font-family: 'Montserrat', sans-serif; }
    .dc-row { display: flex; align-items: center; gap: 14px; padding: 13px 0; border-bottom: 1px solid #efe3de; }
    .dc-row:last-child { border-bottom: none; }
    .dc-ico {
        width: 36px; height: 36px; flex-shrink: 0; border-radius: 11px; background: #f4e8e4; color: #b88f86;
        display: flex; align-items: center; justify-content: center;
    }
    .dc-ico svg { width: 18px; height: 18px; }
    .dc-label { font-size: .7rem; color: #8f8179; line-height: 1.2; }
    .dc-value { font-size: .95rem; font-weight: 600; color: #5a4b41; line-height: 1.35; word-break: break-word; }
    .dc-fecha::first-letter { text-transform: uppercase; }
    .dc-precio { color: #9c766d; font-family: 'Playfair Display', serif; font-size: 1.1rem; }

    /* Aviso de pago pendiente */
    .dc-aviso {
        display: flex; align-items: flex-start; gap: 10px;
        margin: 6px 26px 0; padding: 12px 14px;
        background: #f9ece9; border: 1px solid #ecd0cb; border-radius: 12px;
        font-family: 'Montserrat', sans-serif; font-size: .8rem; line-height: 1.45; color: #8f4a42;
    }
    .dc-aviso svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }

    .dc-footer { background: #faf6f4; display: flex; gap: 12px; padding: 14px 26px 24px; }
    .dc-footer form { flex: 1; margin: 0; }
    .dc-btn {
        flex: 1; width: 100%; border: none; border-radius: 12px; padding: 12px 18px;
        font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: .9rem; text-align: center; text-decoration: none; display: inline-block;
        transition: transform .3s cubic-bezier(.22,.8,.3,1), box-shadow .3s, filter .3s, background-color .2s;
    }
    .dc-btn:focus-visible { outline: 2px solid #b88f86; outline-offset: 2px; }
    .dc-btn-primary { background: linear-gradient(135deg, #9c766d, #5a4b41); color: #fff; box-shadow: 0 6px 14px rgba(90,75,65,.25); }
    .dc-btn-primary:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(90,75,65,.32); filter: brightness(1.06); }
    .dc-btn-sec { background: #e8d5ce; color: #5a4b41; }
    .dc-btn-sec:hover { background: #dcc7be; color: #5a4b41; }
    .dc-btn:disabled, .dc-btn.dc-btn-off {
        background: #ece6e4; color: #a89c98; box-shadow: none; cursor: not-allowed;
        transform: none; filter: none;
    }
</style>

<div class="dc-header">
    <button type="button" class="dc-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">✕</button>
    <div class="dc-eyebrow">Cita #@Model.Id</div>
    <h4>Detalle de la cita</h4>
    <span class="dc-badge @ClaseEstado(Model.Estado)">@TextoEstado(Model.Estado)</span>
</div>

<div class="dc-body">
    <div class="dc-row">
        <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div>
        <div><div class="dc-label">Cliente</div><div class="dc-value">@Model.ClienteNombre</div></div>
    </div>

    @if (mostrarTel)
    {
        <div class="dc-row">
            <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></div>
            <div><div class="dc-label">Teléfono</div><div class="dc-value">@Model.ClienteTelefono</div></div>
        </div>
    }

    <div class="dc-row">
        <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12"/></svg></div>
        <div><div class="dc-label">Servicio</div><div class="dc-value">@Model.ServicioNombre</div></div>
    </div>

    <div class="dc-row">
        <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></div>
        <div><div class="dc-label">Fecha</div><div class="dc-value dc-fecha" style="display:block;">@Model.FechaStr</div></div>
    </div>

    <div class="dc-row">
        <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
        <div><div class="dc-label">Horario</div><div class="dc-value">@Model.HorarioStr</div></div>
    </div>

    @if (esAdmin)
    {
        <div class="dc-row">
            <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18c1.2-2 3-3 5.5-3s4.3 1 5.5 3"/></svg></div>
            <div><div class="dc-label">Estilista</div><div class="dc-value">@Model.EstilistaNombre</div></div>
        </div>
    }

    <div class="dc-row">
        <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg></div>
        <div><div class="dc-label">Precio total</div><div class="dc-value dc-precio">@($"S/ {Model.PrecioTotal:N2}")</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notas))
    {
        <div class="dc-row">
            <div class="dc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg></div>
            <div><div class="dc-label">Notas</div><div class="dc-value">@Model.Notas</div></div>
        </div>
    }
</div>

@if (esEstilista && pagoPendiente)
{
    <div class="dc-aviso">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
        <span>El cliente aún no ha pagado esta cita. Podrás iniciar la atención cuando el pago esté registrado.</span>
    </div>
}

<div class="dc-footer">
    @* Solo el estilista ve los botones de acción *@
    @if (esEstilista)
    {
        if (puedeIniciar)
        {
            <form asp-action="IniciarAtencion" asp-controller="Agenda" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="dc-btn dc-btn-primary" onclick="return confirm('¿Estás seguro de iniciar la atención?');">
                    Iniciar atención
                </button>
            </form>
        }
        else if (pagoPendiente)
        {
            <button type="button" class="dc-btn dc-btn-off" disabled title="Falta registrar el pago">
                Iniciar atención
            </button>
        }
        else if (Model.Estado == EstadoCita.EnProceso)
        {
            <a href="/Agenda/EnProceso/@Model.Id" class="dc-btn dc-btn-primary">Ir al cronómetro</a>
        }
    }

    <button type="button" class="dc-btn dc-btn-sec" data-bs-dismiss="modal">Cerrar</button>
</div>