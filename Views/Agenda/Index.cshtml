@model DKaiza.Web.Estilistas.AgendaEstilistaViewModel
@using DKaiza.Web.Dominio

@{
    ViewData["Title"] = "Agenda Global";
    var estadoActual = ViewBag.EstadoFiltroActual as string ?? "todas";
}

<style>
    /* PALETA PREMIUM BASADA EN TU IMAGEN */
    :root { 
        --bg-page: #faf6f4; /* Dreamy White */
        --color-terracota: #b88f86; /* Redbud SW 6315 */
        --color-marron: #5a4b41; 
        --color-rosa-suave: #e8d5ce; /* Jovial SW 6611 */
        --color-rosa-palido: #f4e8e4; /* Lotus Petal SW 9060 */
        --color-dorado: #d4b4a7; /* Begonia SW 6599 */
    }

    body { background-color: var(--bg-page) !important; }

    .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--color-marron); font-size: 2.8rem; margin-top: 20px; margin-bottom: 5px; }
    .page-subtitle { color: #888; font-family: 'Montserrat', sans-serif; font-size: 0.95rem; margin-bottom: 30px; letter-spacing: 1px; }

    /* Tarjetas de Estadísticas */
    .stat-card {
        background-color: #ffffff;
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        border: 1px solid var(--color-rosa-suave);
        box-shadow: 0 5px 15px rgba(184, 143, 134, 0.05);
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
    }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(184, 143, 134, 0.15); }
    .stat-card.active { border: 2px solid var(--color-terracota); background-color: #fff; }
    
    .stat-number { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: bold; color: var(--color-marron); margin: 0; }
    .stat-label { font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }

    /* Barra de Filtros */
    .filter-container { background-color: #ffffff; border-radius: 50px; padding: 10px 20px; display: inline-flex; align-items: center; box-shadow: 0 10px 25px rgba(184, 143, 134, 0.1); border: 1px solid var(--color-rosa-suave); margin-bottom: 40px; }
    .filter-container form { display: flex; align-items: center; gap: 20px; margin: 0; }
    .filter-item { display: flex; align-items: center; gap: 10px; padding: 5px 15px; }
    .filter-item:not(:last-child) { border-right: 1px solid var(--color-rosa-suave); }
    .filter-container input, .filter-container select { border: none; background: transparent; font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.9rem; color: var(--color-marron); outline: none; cursor: pointer; }
    
    .btn-clear { background-color: transparent; color: #d9534f; border: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; padding: 0; }
    .btn-clear:hover { text-decoration: underline; }

    /* Tarjetas de Citas */
    .cita-card-premium { background-color: #ffffff; border-radius: 20px; padding: 25px; border: 1px solid var(--color-rosa-suave); box-shadow: 0 10px 30px rgba(184, 143, 134, 0.08); transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; text-align: center; }
    .cita-card-premium::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 5px; background-color: var(--color-terracota); }
    .cita-card-premium:hover { transform: translateY(-8px); box-shadow: 0 15px 40px rgba(184, 143, 134, 0.2); border-color: var(--color-terracota); }
    .cita-card-premium.completada { opacity: 0.65; filter: grayscale(80%); }
    
    .avatar-circle { width: 65px; height: 65px; border-radius: 50%; background-color: var(--color-rosa-palido); display: flex; align-items: center; justify-content: center; color: var(--color-terracota); font-weight: bold; font-size: 1.6rem; margin: 0 auto 15px auto; border: 3px solid #ffffff; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .service-title { font-family: 'Playfair Display', serif; color: var(--color-marron); font-weight: bold; font-size: 1.4rem; margin-bottom: 5px; height: 3.4rem; display: flex; align-items: center; justify-content: center; }
    .cita-fecha { font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: #999; font-weight: 500; margin-bottom: 15px; }
    .cliente-text { font-family: 'Montserrat', sans-serif; font-size: 0.9rem; color: #666; margin-bottom: 10px; }
    
    .estado-badge { font-family: 'Montserrat', sans-serif; font-size: 0.75rem; padding: 6px 15px; border-radius: 20px; font-weight: 700; display: inline-block; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 0.5px; }
    .estado-pendiente { background-color: #fef3c7; color: #92400e; } 
    .estado-proceso { background-color: #dbeafe; color: #1e40af; }   
    .estado-completada { background-color: #dcfce7; color: #166534; } 
    .estado-cancelada { background-color: #fee2e2; color: #991b1b; }

    .btn-premium { background-color: var(--color-marron); color: white; border-radius: 30px; padding: 12px; font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.9rem; border: none; width: 100%; transition: 0.3s; text-align: center; text-decoration: none; display: inline-block; }
    .btn-premium:hover { background-color: #433630; color: white; }
</style>

<div class="container py-4">
    <div class="text-center">
        <h1 class="page-title">Agenda Global</h1>
        <p class="page-subtitle">Panel de administración - Visualiza todas las citas</p>
    </div>

    <!-- Filtros por Estado (Las 3 tarjetas) -->
    <div class="row justify-content-center mb-4 g-3">
        <div class="col-md-4">
            <a href="@Url.Action("Index", new { fecha = Model.FechaSeleccionada?.ToString("yyyy-MM-dd"), estilistaIdFiltro = Model.EstilistaIdFiltro, estadoFiltro = "pendientes" })" 
               class="stat-card @(estadoActual == "pendientes" ? "active" : "")">
                <div class="stat-number">⏳</div>
                <div class="stat-label">Citas Pendientes</div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="@Url.Action("Index", new { fecha = Model.FechaSeleccionada?.ToString("yyyy-MM-dd"), estilistaIdFiltro = Model.EstilistaIdFiltro, estadoFiltro = "completadas" })" 
               class="stat-card @(estadoActual == "completadas" ? "active" : "")">
                <div class="stat-number">✅</div>
                <div class="stat-label">Citas Completadas</div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="@Url.Action("Index", new { fecha = Model.FechaSeleccionada?.ToString("yyyy-MM-dd"), estilistaIdFiltro = Model.EstilistaIdFiltro, estadoFiltro = "todas" })" 
               class="stat-card @(estadoActual == "todas" ? "active" : "")">
                <div class="stat-number">📋</div>
                <div class="stat-label">Todas las Citas</div>
            </a>
        </div>
    </div>

    <!-- Barra de Filtros (Fecha y Estilista) -->
    <div class="d-flex justify-content-center">
        <div class="filter-container">
            <form method="get">
                <input type="hidden" name="estadoFiltro" value="@estadoActual" />
                
                <div class="filter-item">
                    <span style="font-size: 1.1rem;">📅</span>
                    <input type="date" name="fecha" value="@(Model.FechaSeleccionada?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
                </div>

                <div class="filter-item">
                    <span style="font-size: 1.1rem;">✂️</span>
                    <select name="estilistaIdFiltro" onchange="this.form.submit()">
                        <option value="">Todos los estilistas</option>
                        @foreach (var est in Model.ListaEstilistas)
                        {
                            <option value="@est.Id" selected="@(Model.EstilistaIdFiltro == est.Id)">
                                @est.NombreCompleto
                            </option>
                        }
                    </select>
                </div>

                @if (Model.FechaSeleccionada.HasValue || Model.EstilistaIdFiltro.HasValue)
                {
                    <div class="filter-item" style="border: none; padding: 0 10px;">
                        <a href="@Url.Action("Index", new { estadoFiltro = estadoActual })" class="btn-clear">✕ Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Lista de Citas -->
    @if (!Model.Citas.Any())
    {
        <div class="text-center py-5">
            <h4 style="font-family: 'Playfair Display', serif; color: #888;">No se encontraron citas con estos filtros.</h4>
        </div>
    }
    else
    {
        <div class="row g-4 justify-content-center">
            @foreach (var cita in Model.Citas)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="cita-card-premium @(cita.Estado == EstadoCita.Completada ? "completada" : "")">
                        <div>
                            <div class="avatar-circle">
                                <span>@(cita.EstilistaNombre.Length > 0 ? cita.EstilistaNombre.Substring(0, 1).ToUpper() : "E")</span>
                            </div>
                            <div class="service-title">@cita.ServicioNombre</div>
                            <div class="cita-fecha">@cita.Inicio.ToString("dd MMM yyyy - HH:mm")</div>
                            <div class="cliente-text">Cliente: @cita.ClienteNombre</div>
                            
                            <div>
                                @if (cita.Estado == EstadoCita.Pendiente) { <span class="estado-badge estado-pendiente">Pendiente</span> }
                                else if (cita.Estado == EstadoCita.Confirmada) { <span class="estado-badge estado-pendiente">Confirmada</span> }
                                else if (cita.Estado == EstadoCita.PendientePago) { <span class="estado-badge estado-pendiente">Pendiente Pago</span> }
                                else if (cita.Estado == EstadoCita.Pagada) { <span class="estado-badge estado-completada">Pagada</span> }
                                else if (cita.Estado == EstadoCita.EnProceso) { <span class="estado-badge estado-proceso">En Proceso</span> }
                                else if (cita.Estado == EstadoCita.Completada) { <span class="estado-badge estado-completada">Completada</span> }
                                else if (cita.Estado == EstadoCita.Cancelada) { <span class="estado-badge estado-cancelada">Cancelada</span> }
                            </div>

                            <div class="badge bg-light text-dark border mt-2">Atendido por: @cita.EstilistaNombre</div>
                        </div>
                        <div class="mt-3">
                            <button class="btn-premium" onclick="verDetalle(@cita.Id)">Ver detalle</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL ESTRUCTURA -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"> 
        <div class="modal-content" id="contenidoModal" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 15px 30px rgba(0,0,0,0.2);">
            <!-- AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalle(id) {
            fetch(`/AdminAgenda/DetalleCita?id=${id}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoModal').innerHTML = html;
                    var myModal = new bootstrap.Modal(document.getElementById('modalDetalle'));
                    myModal.show();
                });
        }
    </script>
}