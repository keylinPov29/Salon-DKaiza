<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Salón de belleza D'Kaiza</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="dk-nav">
        <a class="dk-nav__brand" href="/">Salón de belleza D'Kaiza</a>
        <div class="dk-nav__links">
            @if (User.IsInRole("Administrador"))
            {
                <a class="dk-nav__link" href="/admin/categorias">Catálogo de servicios</a>
            }
            else
            {
                <a class="dk-nav__link" href="/">Servicios</a>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="dk-nav__user">@User.Identity!.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="dk-nav__form">
                    <button type="submit" class="dk-nav__link">Cerrar sesión</button>
                </form>
            }
            else
            {
                <a class="dk-nav__link" href="/cuenta/login">Iniciar sesión</a>
            }
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="dk-toast dk-toast--ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="dk-toast dk-toast--err">@TempData["Error"]</div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="dk-footer">
        <div class="dk-container">
            <div class="dk-footer__bottom" style="padding-top:0">
                <span class="dk-footer__copy">&copy; @DateTime.Now.Year Salón de belleza D'Kaiza</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('.dk-toast').forEach(function (t) {
            setTimeout(function () { t.style.opacity = '0'; setTimeout(function () { t.remove(); }, 300); }, 3000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>