@{
    var rutaActual = Context.Request.Path.Value?.ToLower() ?? "/";
    bool EsActivo(string ruta, bool exacto = false) =>
        exacto ? rutaActual == ruta.ToLower() : rutaActual.StartsWith(ruta.ToLower());
    
    bool enReportes = rutaActual.Contains("/adminreportes");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Salón de belleza D'Kaiza</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (User.Identity?.IsAuthenticated != true || User.IsInRole("Cliente"))
    {
        <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    }

    @RenderSection("Styles", required: false)

    <style>
        /* ===== PALETA OFICIAL ===== */
        :root {
            --layout-bg-dark: #9b7b6d; 
            --layout-badge-bg: #c47d5c; 
            --layout-text-light: #fcf9f2; 
            --layout-text-muted: #f5ebe6; 
            --layout-hover-color: #e6dacb; 
            --layout-border-color: #bca59a; 
        }

        /* ===== NAVBAR BLINDADO ===== */
        #main-navbar {
            background-color: var(--layout-bg-dark) !important;
            padding: 12px 40px !important;
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2) !important;
            position: sticky !important;
            top: 0 !important;
            z-index: 1050 !important;
            border-bottom: 1px solid var(--layout-border-color) !important;
        }

        #main-navbar a, 
        #main-navbar button,
        #main-navbar span {
            color: var(--layout-text-muted) !important;
            opacity: 1 !important;
            filter: none !important;
        }

        #main-navbar .dk-nav__brand {
            display: inline-flex !important;
            align-items: center !important;
            gap: 12px !important;
            text-decoration: none !important;
        }
        
        #main-navbar .dk-nav__logo {
            width: 40px !important; height: 40px !important;
            display: inline-flex !important; align-items: center !important; justify-content: center !important;
            border-radius: 50% !important;
            font-family: 'Playfair Display', serif !important;
            font-size: 1.2rem !important;
            font-weight: 600 !important;
            color: var(--layout-bg-dark) !important;
            background: var(--layout-text-light) !important;
        }
        
        #main-navbar .dk-nav__brandtext {
            display: inline-flex !important; flex-direction: column !important;
            font-family: 'Playfair Display', serif !important;
            font-size: 1.3rem !important; font-weight: 600 !important; line-height: 1.1 !important;
            color: var(--layout-text-light) !important;
        }
        #main-navbar .dk-nav__brandtext small {
            font-size: .6rem !important; font-weight: 500 !important;
            letter-spacing: 1.5px !important; text-transform: uppercase !important;
            color: var(--layout-text-muted) !important;
            margin-top: 2px !important;
        }

        #main-navbar .dk-nav__links {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
        }

        #main-navbar .dk-nav__link {
            color: var(--layout-text-muted) !important;
            font-weight: 500 !important;
            font-size: 0.95rem !important;
            text-decoration: none !important;
            padding: 8px 16px !important;
            border-radius: 20px !important;
            transition: all 0.2s ease !important;
        }

        #main-navbar .dk-nav__link:hover {
            color: var(--layout-text-light) !important;
            background-color: rgba(255, 255, 255, 0.15) !important;
        }

        /* PÍLDORA ACTIVA */
        #main-navbar .dk-nav__link.active {
            background-color: var(--layout-text-light) !important;
            color: var(--layout-bg-dark) !important;
            font-weight: 700 !important;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
        }

        #main-navbar .dk-nav__user {
            display: flex !important;
            align-items: center !important;
            color: var(--layout-text-light) !important;
            font-weight: 500 !important;
            font-size: 0.9rem !important;
            margin-left: 15px !important;
            padding-left: 15px !important;
            border-left: 1px solid var(--layout-border-color) !important;
        }

        #main-navbar .badge-rol {
            background-color: var(--layout-badge-bg) !important;
            color: #ffffff !important;
            font-size: 0.6rem !important;
            padding: 3px 8px !important;
            border-radius: 12px !important;
            text-transform: uppercase !important;
            font-weight: bold !important;
            margin-right: 8px !important;
        }

        /* ===== BOTÓN DE CERRAR SESIÓN MEJORADO ===== */
        #main-navbar .dk-nav__form { margin: 0 !important; padding: 0 !important; }
        
        #main-navbar .dk-nav__logout {
            background: transparent !important;
            border: 1px solid var(--layout-text-light) !important; /* Borde blanco */
            color: var(--layout-text-light) !important;
            font-weight: 500 !important;
            font-size: 0.85rem !important;
            padding: 6px 16px !important;
            border-radius: 20px !important; /* Bordes redondeados */
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
        }

        #main-navbar .dk-nav__logout:hover {
            background-color: var(--layout-text-light) !important;
            color: var(--layout-bg-dark) !important; /* Invierte colores al pasar el mouse */
            border-color: var(--layout-text-light) !important;
            transform: translateY(-1px) !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15) !important;
        }

        /* ===== FOOTER BLINDADO ===== */
        #main-footer {
            background-color: var(--layout-bg-dark) !important;
            padding: 50px 0 30px 0 !important;
            margin-top: 60px !important;
            color: var(--layout-text-muted) !important;
            position: relative !important;
            z-index: 1050 !important;
            border-top: 2px solid var(--layout-border-color) !important;
        }

        #main-footer .footer-link {
            color: var(--layout-text-muted) !important;
            transition: color 0.2s !important;
            text-decoration: none !important;
        }
        #main-footer .footer-link:hover {
            color: var(--layout-hover-color) !important;
        }

        #main-footer .social-link {
            color: var(--layout-text-muted) !important;
            text-decoration: none !important;
            transition: color 0.2s !important;
            margin-left: 15px !important;
        }
        #main-footer .social-link:hover {
            color: var(--layout-hover-color) !important;
        }

        #main-footer h4, #main-footer h6 { color: var(--layout-text-light) !important; }
        #main-footer p, #main-footer span, #main-footer div { color: var(--layout-text-muted) !important; }
        #main-footer hr { border-color: var(--layout-border-color) !important; opacity: 1 !important; }
    </style>
</head>

<body>
    <!-- NAVBAR CON ID -->
    <nav class="dk-nav" id="main-navbar">
        <a class="dk-nav__brand" href="/">
            <span class="dk-nav__logo">D</span>
            <span class="dk-nav__brandtext">
                D'Kaiza
                <small>Salón de belleza</small>
            </span>
        </a>

        <div class="dk-nav__links">
            @if (User.IsInRole("Administrador"))
            {
                <a class="dk-nav__link @(EsActivo("/admin/categorias") ? "active" : "")" href="/admin/categorias">Catálogo</a>
                <a class="dk-nav__link @(EsActivo("/admin/estilistas") ? "active" : "")" href="/admin/estilistas">Estilistas</a>
                <a class="dk-nav__link @(EsActivo("/AdminAgenda") ? "active" : "")" href="/AdminAgenda">Agenda</a>
                <a class="dk-nav__link @(EsActivo("/admin/clientes") ? "active" : "")" href="/admin/clientes">Historial</a>
                <a class="dk-nav__link @(enReportes ? "active" : "")" href="/AdminReportes">Reportes</a>
            }
            else if (User.IsInRole("Estilista"))
            {
                <a class="dk-nav__link @(EsActivo("/Agenda") ? "active" : "")" href="/Agenda">Mi Agenda</a>
                <a class="dk-nav__link @(EsActivo("/clientes") ? "active" : "")" href="/clientes">Clientes</a>
            }
            else if (User.IsInRole("Cliente") || User.Identity?.IsAuthenticated != true)
            {
                <a class="dk-nav__link @(EsActivo("/", true) ? "active" : "")" href="/">Servicios</a>
                <a class="dk-nav__link @(EsActivo("/estilistas") ? "active" : "")" href="/estilistas">Estilistas</a>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dk-nav__user">
                    <span class="badge-rol">
                        @(User.IsInRole("Administrador") ? "Admin" : User.IsInRole("Estilista") ? "Estilista" : "Cliente")
                    </span>
                    @User.Identity!.Name
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="dk-nav__form">
                    <!-- BOTÓN CON ICONO DE SALIDA -->
                    <button type="submit" class="dk-nav__logout">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </button>
                </form>
            }
            else
            {
                <a class="dk-nav__link @(EsActivo("/cuenta/login") ? "active" : "")" href="/cuenta/login">Iniciar sesión</a>
                <a class="dk-nav__link @(EsActivo("/cuenta/registro") ? "active" : "")" href="/cuenta/registro">Registrarse</a>
            }
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="dk-toast dk-toast--ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="dk-toast dk-toast--err">@TempData["Error"]</div>
    }

    <main>
        @RenderBody()
    </main>

    <!-- FOOTER CON ID -->
    <footer class="dk-footer" id="main-footer" style="font-family: 'Montserrat', sans-serif;">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h4 style="font-family: 'Playfair Display', serif; font-weight: bold; margin-bottom: 15px; font-size: 1.5rem;">
                        D'Kaiza
                    </h4>
                    <p style="font-size: 0.9rem; line-height: 1.6;">
                        Elegancia que transforma. Tu salón de belleza premium en Lima.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 1px; font-weight: 700;">
                        Enlaces
                    </h6>
                    <ul class="list-unstyled" style="font-size: 0.9rem;">
                        <li class="mb-2"><a href="/" class="footer-link">Inicio</a></li>
                        <li class="mb-2"><a href="/" class="footer-link">Servicios</a></li>
                        <li class="mb-2"><a href="#sobre-nosotros" class="footer-link">Nosotros</a></li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 1px; font-weight: 700;">
                        Contacto
                    </h6>
                    <ul class="list-unstyled" style="font-size: 0.9rem;">
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span style="color: var(--layout-text-light) !important;">📍</span> Av. Principal 123, Lima
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span style="color: var(--layout-text-light) !important;">📞</span> +51 999 888 777
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span style="color: var(--layout-text-light) !important;">✉️</span> hola@dkaiza.com
                        </li>
                    </ul>
                </div>
            </div>

            <hr style="border-color: var(--layout-border-color); margin-top: 20px; margin-bottom: 20px; opacity: 1;" />

            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="small" style="font-size: 0.8rem;">
                    &copy; @DateTime.Now.Year Salón de belleza D'Kaiza. Todos los derechos reservados.
                </div>
                <div class="d-flex mt-2 mt-md-0">
                    <a href="#" class="social-link">Instagram</a>
                    <a href="#" class="social-link">Facebook</a>
                    <a href="#" class="social-link">TikTok</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AÑADIMOS BOOTSTRAP ICONS PARA EL ICONO DEL BOTÓN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        document.querySelectorAll('.dk-toast').forEach(function (toast) {
            setTimeout(function () { toast.style.opacity = '0'; setTimeout(function () { toast.remove(); }, 300); }, 3000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @* ── Chatbot de atención al cliente (solo para clientes y visitantes) ── *@
    @if (User.Identity?.IsAuthenticated != true || User.IsInRole("Cliente"))
    {
        @await Html.PartialAsync("_Chatbot")
        <script src="~/js/chatbot.js" asp-append-version="true"></script>
    }
</body>
</html>