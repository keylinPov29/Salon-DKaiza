<script>
    (function () {
        document.querySelectorAll('.dk-alert[data-auto]').forEach(function (el) {
            setTimeout(function () {
                el.style.transition = 'opacity .5s';
                el.style.opacity = '0';
                setTimeout(function () { el.remove(); }, 500);
            }, 4000);
        });
    })();
</script>