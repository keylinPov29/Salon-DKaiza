@* ═══════════════════════════════════════════════════════
   CHATBOT – PARTIAL VIEW
   Ícono flotante + ventana emergente de chat
   ═══════════════════════════════════════════════════════ *@

<!-- ─── BOTÓN FLOTANTE ─────────────────────────────── -->
<button id="chatbot-toggle" class="chatbot-fab" title="Abrir chat de ayuda" aria-label="Abrir chatbot">
    <svg id="chatbot-icon-open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <svg id="chatbot-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
</button>

<!-- ─── VENTANA DE CHAT ────────────────────────────── -->
<div id="chatbot-window" class="chatbot-window" hidden>
    <!-- Header -->
    <div class="chatbot-header">
        <div class="chatbot-header__info">
            <div class="chatbot-header__avatar">D</div>
            <div>
                <div class="chatbot-header__name">D'Kaiza Bot</div>
                <div class="chatbot-header__status">
                    <span class="chatbot-header__dot"></span> En línea
                </div>
            </div>
        </div>
        <button id="chatbot-close" class="chatbot-header__close" aria-label="Cerrar chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>

    <!-- Mensajes -->
    <div id="chatbot-messages" class="chatbot-messages">
        <!-- Los mensajes se insertan por JS -->
    </div>

    <!-- Sugerencias rápidas -->
    <div id="chatbot-suggestions" class="chatbot-suggestions">
        <!-- Botones de preguntas sugeridas cargados por JS -->
    </div>

    <!-- Input -->
    <div class="chatbot-input">
        <input id="chatbot-input-text"
               type="text"
               maxlength="200"
               placeholder="Escribe tu consulta..."
               autocomplete="off" />
        <span id="chatbot-char-count" class="chatbot-char-count">0/200</span>
        <button id="chatbot-send" class="chatbot-send" aria-label="Enviar mensaje" disabled>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
        </button>
    </div>
</div>

