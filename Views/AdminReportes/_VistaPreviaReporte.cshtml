@model DKaiza.Web.Models.ReporteUnificadoViewModel

<style>
    .pdf-container { background-color: #525659; padding: 30px; display: flex; flex-direction: column; align-items: center; gap: 30px; }
    .hoja-a4 { background-color: white; width: 100%; max-width: 800px; min-height: 1100px; padding: 50px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); color: #333; font-family: 'Montserrat', sans-serif; }
    .section-title { color: #6c3b5a; font-family: 'Playfair Display', serif; font-size: 1.2rem; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px; margin-top: 30px; }
    .resumen-box { flex: 1; background-color: #fbf8f6; padding: 15px; border-radius: 8px; }
    .resumen-label { font-size: 0.65rem; color: #888; text-transform: uppercase; font-weight: 700; }
    .resumen-value { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: bold; color: #333; }
    .tabla-pdf th, .tabla-pdf td { padding: 8px; font-size: 0.8rem; color: #555; border-bottom: 1px solid #f0f0f0; }
    .pago-box { padding: 15px; border-radius: 8px; text-align: center; }
    .pdf-toolbar { background-color: #323639; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
</style>

<!-- Barra de Herramientas (Visual) -->
<div class="pdf-toolbar">
    <div class="fw-bold"><i class="bi bi-file-earmark-pdf me-2"></i> Vista Previa del Reporte</div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-light" onclick="alert('Simulando impresión...')">
            <i class="bi bi-printer"></i> Imprimir
        </button>
        <button type="button" class="btn btn-sm btn-success" onclick="alert('Simulando descarga...')">
            <i class="bi bi-download"></i> Descargar
        </button>
        <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">
            <i class="bi bi-x-lg"></i> Cerrar
        </button>
    </div>
</div>

<!-- Contenedor de las Hojas -->
<div class="pdf-container">
    
    <!-- HOJA 1: Resumen y Desglose -->
    <div class="hoja-a4">
        <h2 style="font-family: 'Playfair Display', serif; color: #222;">Reporte anual @Model.AnioSeleccionado</h2>
        <p class="text-muted small mb-4">Del 1 de enero al 31 de diciembre de @Model.AnioSeleccionado · Todas las estilistas</p>

        <!-- 01 Resumen -->
        <h5 class="section-title" style="margin-top: 0;">01 | Resumen del año</h5>
        <div class="d-flex gap-2 mb-4">
            <div class="resumen-box">
                <div class="resumen-label">SERVICIOS COMPLETADOS</div>
                <div class="resumen-value">@Model.CantidadServicios</div>
            </div>
            <div class="resumen-box">
                <div class="resumen-label">INGRESOS POR SERVICIOS</div>
                <div class="resumen-value">S/ @Model.GranTotal.ToString("N2")</div>
            </div>
            <div class="resumen-box">
                <div class="resumen-label">INGRESO MEDIO / SERVICIO</div>
                <div class="resumen-value">S/ @((Model.GranTotal / (Model.CantidadServicios > 0 ? Model.CantidadServicios : 1)).ToString("N2"))</div>
            </div>
        </div>
        
        <p class="small text-muted mb-4">En total se registraron @Model.CantidadServicios servicios y S/ @Model.GranTotal en ingresos. @Model.EstilistaTop lidera el año con su desempeño.</p>

        <!-- 02 Desglose mensual REAL -->
        <h5 class="section-title">02 | Desglose anual de servicios</h5>
        <div class="text-end small text-muted mb-2">Cantidad de servicios e ingresos en S/</div>
        <table class="table table-sm table-borderless tabla-pdf">
            <thead style="background-color: #f3ebe1;">
                <tr>
                    <th>Mes</th>
                    @foreach (var col in Model.NombresServiciosColumnas.Take(4)) {
                        <th class="text-center text-truncate" style="max-width: 80px;" title="@col">@col</th>
                    }
                    <th class="text-center">Total</th>
                    <th class="text-end">Ingresos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mes in Model.DesgloseMensualReal)
                {
                    <tr>
                        <td class="text-capitalize">@mes.MesNombre</td>
                        @foreach (var col in Model.NombresServiciosColumnas.Take(4))
                        {
                            var cant = mes.CantidadPorServicio.ContainsKey(col) ? mes.CantidadPorServicio[col] : 0;
                            <td class="text-center">@cant</td>
                        }
                        <td class="text-center fw-bold">@mes.TotalCitas</td>
                        <td class="text-end">S/ @mes.TotalIngresos.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot style="background-color: #e8dce3; font-weight: bold;">
                <tr>
                    <td>Total @Model.AnioSeleccionado</td>
                    @foreach (var col in Model.NombresServiciosColumnas.Take(4))
                    {
                        var totalServ = Model.DesgloseMensualReal.Sum(m => m.CantidadPorServicio.ContainsKey(col) ? m.CantidadPorServicio[col] : 0);
                        <td class="text-center">@totalServ</td>
                    }
                    <td class="text-center">@Model.CantidadServicios</td>
                    <td class="text-end">S/ @Model.GranTotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- 03 Desempeño por estilista REAL -->
        <h5 class="section-title">03 | Desempeño anual por estilista</h5>
        <div class="row mt-3">
            @foreach(var est in Model.TablaEstilistas.Take(4)) {
                <div class="col-3 text-center">
                    <div class="fw-bold text-truncate" title="@est.Nombre">@est.Nombre</div>
                    <div class="fs-4">@est.Total</div>
                    <div class="text-muted small">@((est.Total * 100 / (Model.CantidadServicios > 0 ? Model.CantidadServicios : 1)).ToString("F1"))% del año</div>
                </div>
            }
        </div>
    </div>

    <!-- HOJA 2: Ingresos y Pagos -->
    <div class="hoja-a4">
        <!-- 04 Reporte de Ingresos -->
        <h5 class="section-title" style="margin-top: 0;">04 | Reporte de ingresos</h5>
        <div class="text-end small text-muted mb-3">01/01/@Model.AnioSeleccionado - @Model.FechaFin?.ToString("dd/MM/yyyy")</div>
        
        <div class="row g-2 mb-4">
            <div class="col-3">
                <div class="pago-box" style="background-color: #f3ebe1; border-left: 3px solid #c9a8a1;">
                    <div class="small text-muted">EFECTIVO</div>
                    <div class="fs-4">S/ @Model.TotalEfectivo.ToString("N2")</div>
                </div>
            </div>
            <div class="col-3">
                <div class="pago-box" style="background-color: #f3ebe1; border-left: 3px solid #cfcaca;">
                    <div class="small text-muted">TARJETA</div>
                    <div class="fs-4">S/ @Model.TotalTarjeta.ToString("N2")</div>
                </div>
            </div>
            <div class="col-3">
                <div class="pago-box" style="background-color: #6c3b5a; color: white;">
                    <div class="small text-light opacity-75">TOTAL DEL PERIODO</div>
                    <div class="fs-4">S/ @Model.GranTotal.ToString("N2")</div>
                </div>
            </div>
            <div class="col-3">
                <div class="pago-box" style="background-color: #f3ebe1;">
                    <div class="small text-muted">SERVICIOS</div>
                    <div class="fs-4">@Model.CantidadServicios</div>
                </div>
            </div>
        </div>

        <!-- Historial de citas -->
        <h6 class="fw-bold mb-2">Historial de citas</h6>
        <table class="table table-sm table-borderless tabla-pdf">
            <thead style="background-color: #f3ebe1;">
                <tr>
                    <th>FECHA</th>
                    <th>HORA</th>
                    <th>CLIENTE</th>
                    <th>SERVICIO</th>
                    <th>MÉTODO</th>
                    <th class="text-end">MONTO</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var t in Model.Transacciones.Take(5)) {
                    <tr>
                        <td>@t.FechaTransaccion.ToString("dd/MM/yyyy")</td>
                        <td>@t.FechaTransaccion.ToString("HH:mm")</td>
                        <td>@t.Cliente</td>
                        <td>@t.Servicio</td>
                        <td>
                            <span class="badge rounded-pill" style="background-color: @(t.MetodoPago == "Tarjeta" ? "#cfcaca" : "#c9a8a1"); color: #333;">
                                @t.MetodoPago
                            </span>
                        </td>
                        <td class="text-end fw-bold">S/ @t.Monto.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot style="background-color: #e8dce3; font-weight: bold;">
                <tr>
                    <td colspan="5">Total del periodo · @Model.CantidadServicios servicios</td>
                    <td class="text-end">S/ @Model.GranTotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- Distribución de pagos (Barra Real) -->
        <h6 class="fw-bold mt-4">Distribución de pagos</h6>
        <div class="d-flex justify-content-center my-4">
            @{
                var pctEfectivo = Model.GranTotal > 0 ? (Model.TotalEfectivo / Model.GranTotal * 100) : 0;
                var pctTarjeta = Model.GranTotal > 0 ? (Model.TotalTarjeta / Model.GranTotal * 100) : 0;
            }
            <div style="width: 300px; height: 20px; border-radius: 10px; display: flex; overflow: hidden;">
                <div style="width: @(pctEfectivo)%; background-color: #6c3b5a;"></div>
                <div style="width: @(pctTarjeta)%; background-color: #cfcaca;"></div>
            </div>
        </div>
        <div class="d-flex justify-content-between small text-muted">
            <span><span style="display:inline-block; width:10px; height:10px; background:#6c3b5a; border-radius:2px;"></span> Efectivo (@pctEfectivo.ToString("F0")%)</span>
            <span><span style="display:inline-block; width:10px; height:10px; background:#cfcaca; border-radius:2px;"></span> Tarjeta (@pctTarjeta.ToString("F0")%)</span>
        </div>
        <div class="text-end small text-muted mt-2 border-top pt-2">Promedio por servicio: S/ @((Model.GranTotal / (Model.CantidadServicios > 0 ? Model.CantidadServicios : 1)).ToString("N2"))</div>
    </div>

</div>