@model DKaiza.Web.Models.ReporteUnificadoViewModel
@{
    ViewData["Title"] = "Reportes Anuales";
    var metodoActual = Context.Request.Query["metodoPago"].ToString();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
}

<style>
    /* --- PALETA DE COLORES: SOLO PARA REPORTES --- */
    .reportes-page {
        --bg-page: #faf8f6;
        --text-dark: #4a4044;
        --text-muted: #988d91;
        --rose: #c9a8a1;
        --grey: #cfcaca;
        --beige: #ebe2d8;
        --cream-border: #f3ebe1;
        --dark-brown: #3d2b1f;
        --white: #ffffff;

        --radius: 18px;
        --shadow-sm: 0 1px 2px rgba(0,0,0,.03), 0 4px 14px rgba(0,0,0,.035);
        --shadow-md: 0 2px 4px rgba(0,0,0,.04), 0 12px 28px rgba(0,0,0,.08);
        --ease: cubic-bezier(.22,.8,.3,1);
    }

    /* ===== ANIMACIONES ===== */
    @@keyframes aparecer {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .reveal { animation: aparecer .6s var(--ease) both; }
    .d1 { animation-delay: .05s; } .d2 { animation-delay: .12s; } .d3 { animation-delay: .19s; }
    .d4 { animation-delay: .26s; } .d5 { animation-delay: .33s; }

    /* ===== ENCABEZADO ===== */
    .page-head { padding-bottom: 18px; margin-bottom: 26px; border-bottom: 1px solid var(--beige); }
    .page-eyebrow {
        display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: 2px;
        text-transform: uppercase; color: var(--rose); margin-bottom: 6px;
    }
    .page-title { font-family: 'Playfair Display', serif; font-size: 2.3rem; font-weight: 700; color: var(--text-dark); margin: 0 0 4px; }
    .page-sub { color: var(--text-muted); font-size: .92rem; margin: 0; }

    .year-select {
        width: 150px; border: 1px solid var(--beige) !important; border-radius: 50px; font-weight: 600; font-size: .85rem;
        color: var(--text-dark); padding-left: 20px; background-color: var(--white); box-shadow: var(--shadow-sm);
        cursor: pointer; transition: border-color .25s, box-shadow .25s;
    }
    .year-select:focus { border-color: var(--rose) !important; box-shadow: 0 0 0 4px rgba(201,168,161,.25); }

    .btn-custom {
        position: relative; overflow: hidden; background-color: var(--rose); color: white; border-radius: 50px;
        padding: 10px 24px; font-weight: 600; font-size: .88rem; border: none; letter-spacing: .3px;
        box-shadow: 0 6px 14px rgba(201,168,161,.4);
        transition: transform .3s var(--ease), box-shadow .3s var(--ease), background-color .2s;
    }
    .btn-custom::after {
        content: ''; position: absolute; top: 0; left: -80%; width: 50%; height: 100%;
        background: linear-gradient(120deg, transparent, rgba(255,255,255,.4), transparent);
        transform: skewX(-20deg); transition: left .7s var(--ease);
    }
    .btn-custom:hover { background-color: #b59191; color: white; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(201,168,161,.5); }
    .btn-custom:hover::after { left: 130%; }
    .btn-custom:active { transform: translateY(0) scale(.98); }

    /* ===== TARJETAS HERO ===== */
    .hero-card {
        position: relative; overflow: hidden; border-radius: var(--radius); padding: 24px 30px;
        display: flex; justify-content: space-between; align-items: center; height: 100%;
        border: none; box-shadow: var(--shadow-sm);
        transition: transform .35s var(--ease), box-shadow .35s var(--ease);
    }
    .hero-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .hero-card::before {
        content: ''; position: absolute; top: -70px; right: -50px; width: 200px; height: 200px;
        border-radius: 50%; background: rgba(255,255,255,.18); pointer-events: none;
    }
    .hero-card::after {
        content: ''; position: absolute; bottom: -90px; right: 70px; width: 160px; height: 160px;
        border-radius: 50%; background: rgba(255,255,255,.1); pointer-events: none;
    }
    .hero-card > * { position: relative; z-index: 1; }
    .hero-label { font-size: .7rem; text-transform: uppercase; letter-spacing: 1.8px; font-weight: 700; margin-bottom: 8px; display: block; }
    .hero-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: bold; margin: 0; line-height: 1.15; }

    .hero-estilista { background: var(--rose); color: white; }
    .hero-estilista .hero-label { color: rgba(255,255,255,0.9); }
    .hero-servicio { background: var(--beige); color: var(--text-dark); border: 1px solid #e0d6cd; }
    .hero-servicio .hero-label { color: #666; }

    .hero-iconbox {
        width: 62px; height: 62px; flex-shrink: 0; border-radius: 18px;
        display: flex; align-items: center; justify-content: center; font-size: 1.8rem;
        transition: transform .4s var(--ease);
    }
    .hero-card:hover .hero-iconbox { transform: rotate(-6deg) scale(1.08); }
    .hero-estilista .hero-iconbox { background: rgba(255,255,255,.22); color: #fff; }
    .hero-servicio .hero-iconbox { background: rgba(201,168,161,.3); color: var(--rose); }

    /* ===== PANELES ===== */
    .card-panel {
        background-color: var(--white); border-radius: var(--radius); padding: 26px;
        border: 1px solid #f0eaea; box-shadow: var(--shadow-sm); height: 100%;
    }
    .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
    .card-title { font-size: 1.05rem; color: var(--text-dark); margin: 0; font-weight: 700; }
    .card-sub { font-size: .78rem; color: var(--text-muted); margin: 2px 0 0; }
    .panel-chip {
        font-size: .7rem; font-weight: 700; color: var(--text-dark); background: var(--cream-border);
        border: 1px solid var(--beige); padding: 4px 12px; border-radius: 999px; white-space: nowrap;
    }

    /* ===== SERVICIOS TOP ===== */
    .rank-item { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; }
    .rank-item:last-child { margin-bottom: 0; }
    .rank-num {
        width: 28px; height: 28px; flex-shrink: 0; border-radius: 50%; font-size: .75rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center; background: var(--beige); color: var(--text-dark);
    }
    .rank-item:first-child .rank-num { background: var(--rose); color: #fff; }
    .rank-body { flex: 1; min-width: 0; }
    .rank-line { display: flex; justify-content: space-between; gap: 8px; font-size: .82rem; font-weight: 600; margin-bottom: 6px; }
    .rank-line span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rank-line .text-muted { font-weight: 500; font-size: .76rem; white-space: nowrap; }

    .progress-custom { height: 8px; background-color: var(--beige); border-radius: 10px; overflow: hidden; }
    .progress-bar-custom {
        height: 100%; background-color: var(--rose); border-radius: 10px;
        transform-origin: left; animation: crecer 1.1s var(--ease) both .3s;
    }
    @@keyframes crecer { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    /* ===== FILTROS Y MÉTRICAS ===== */
    .filter-card {
        background-color: var(--white); border-radius: 14px; padding: 12px;
        box-shadow: var(--shadow-sm); border: 1px solid var(--beige); height: 100%;
    }
    .filter-card input { border: none; border-bottom: 1px solid var(--grey); border-radius: 0; padding-left: 0; font-size: .8rem; background: transparent; }
    .filter-card input:focus { box-shadow: none; border-bottom: 1px solid var(--rose); }
    .filter-card .btn { transition: transform .25s var(--ease), filter .2s; }
    .filter-card .btn:hover { transform: translateY(-1px); filter: brightness(.96); }

    .metric-box {
        position: relative; overflow: hidden; border-radius: 14px; padding: 16px 12px; text-align: center;
        display: flex; flex-direction: column; justify-content: center; height: 100%;
        text-decoration: none; cursor: pointer; border: 2px solid transparent;
        transition: transform .3s var(--ease), box-shadow .3s var(--ease);
    }
    .metric-box:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .metric-title { font-size: .7rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 1.2px; opacity: .9; }
    .metric-value { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: bold; margin: 0; }

    .box-efectivo { background-color: var(--rose); color: white; }
    .box-tarjeta { background-color: var(--grey); color: var(--text-dark); }
    .box-total { background-color: var(--cream-border); color: var(--text-dark); border: 2px solid var(--dark-brown); }
    .box-servicios { background-color: var(--beige); color: var(--text-dark); cursor: default; }
    .box-servicios:hover { transform: none; box-shadow: none; }

    .active-box { border: 3px solid var(--dark-brown) !important; transform: scale(1.02); }

    /* ===== TABLA DE TRANSACCIONES ===== */
    .table-custom { width: 100%; border-collapse: separate; border-spacing: 0; }
    .table-custom th {
        font-size: .7rem; text-transform: uppercase; letter-spacing: .8px; color: var(--text-muted);
        background: #fcfaf9; border-bottom: 1px solid var(--beige); padding: 12px 10px; font-weight: 700; text-align: left;
    }
    .table-custom th:first-child { border-top-left-radius: 10px; }
    .table-custom th:last-child { border-top-right-radius: 10px; }
    .table-custom td { font-size: .88rem; vertical-align: middle; border-bottom: 1px solid #f6f1ee; padding: 13px 10px; transition: background-color .2s; }
    .table-custom tbody tr:hover td { background-color: var(--bg-page); }
    .table-custom tbody tr:last-child td { border-bottom: none; }

    .badge-metodo { background-color: var(--rose); color: white; font-size: .72rem; padding: 5px 12px; border-radius: 999px; font-weight: 600; display: inline-block; letter-spacing: .3px; }
    .badge-tarjeta { background-color: var(--grey); color: var(--text-dark); }

    .empty-row { text-align: center; padding: 38px 10px !important; color: var(--text-muted); }
    .empty-row i { display: block; font-size: 1.8rem; color: var(--rose); margin-bottom: 8px; }

    /* ===== DONA ===== */
    .dona-wrap { position: relative; height: 170px; width: 100%; }
    .dona-centro {
        position: absolute; inset: 0; display: flex; flex-direction: column;
        align-items: center; justify-content: center; pointer-events: none;
    }
    .dona-centro small { font-size: .62rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); font-weight: 700; }
    .dona-centro strong { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--text-dark); }
    .leyenda { display: flex; gap: 22px; font-size: .78rem; font-weight: 600; color: var(--text-muted); }
    .leyenda i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }

    /* ===== TABLA DE ESTILISTAS ===== */
    .avatar-circle {
        width: 35px; height: 35px; border-radius: 50%; background-color: var(--rose);
        display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: .75rem; color: white;
        box-shadow: 0 0 0 3px rgba(201,168,161,.22);
    }
    .table-container { width: 100%; overflow-x: auto; border-radius: 14px; border: 1px solid #f0eaea; background-color: var(--white); }
    .table-estilistas { width: 100%; border-collapse: collapse; min-width: 800px; }
    .table-estilistas th {
        background-color: #fcfaf9; color: #888; font-size: .68rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .8px; padding: 14px 10px; text-align: center; border-bottom: 1px solid var(--beige); white-space: nowrap;
    }
    .table-estilistas td { padding: 12px 10px; text-align: center; border-bottom: 1px solid #f5f1ee; color: #555; font-size: .85rem; }
    .table-estilistas tbody tr:last-child td { border-bottom: none; }
    .table-estilistas th.sticky, .table-estilistas td.sticky {
        position: sticky; left: 0; background-color: var(--white); text-align: left; z-index: 2;
        border-right: 1px solid #eee; white-space: nowrap;
    }
    .table-estilistas th.sticky { background-color: #fcfaf9; z-index: 3; }
    .table-estilistas tbody tr:nth-child(even) td { background-color: #fdfbfa; }
    .table-estilistas tbody tr:hover td,
    .table-estilistas tbody tr:hover td.sticky { background-color: var(--bg-page); }
    .table-estilistas .avatar-circle { width: 30px; height: 30px; font-size: .65rem; }
    .num-servicio { color: #999; }
    .num-total { font-weight: bold; color: var(--rose); }
    .num-dinero { font-weight: 700; color: var(--dark-brown); }
    .table-container::-webkit-scrollbar { height: 6px; }
    .table-container::-webkit-scrollbar-track { background: transparent; }
    .table-container::-webkit-scrollbar-thumb { background: #ddd; border-radius: 10px; }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
    }
    @@media (max-width: 767px) {
        .page-title { font-size: 1.8rem; }
        .hero-title { font-size: 1.5rem; }
        .card-panel { padding: 20px; }
    }
</style>

<div class="reportes-page">
<div class="container-fluid py-4 px-4">

    <!-- ENCABEZADO -->
    <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3 reveal">
        <div>
            <span class="page-eyebrow">Panel de administración</span>
            <h1 class="page-title">Reportes Anuales</h1>
            <p class="page-sub">Visión general del rendimiento del salón y del equipo.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <form method="get" class="m-0">
                <input type="hidden" name="fechaInicio" value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="fechaFin" value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                <select name="anio" class="form-select year-select" onchange="this.form.submit()">
                    @foreach(var a in Model.AniosDisponibles) {
                        <option value="@a" selected="@(Model.AnioSeleccionado == a)">Año: @a</option>
                    }
                </select>
            </form>
            <button class="btn btn-custom" onclick="abrirVistaPrevia()">
                <i class="bi bi-file-earmark-pdf me-2"></i> Generar Reporte
            </button>
        </div>
    </div>

    <!-- HEROES -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 reveal d1">
            <div class="hero-card hero-estilista">
                <div>
                    <span class="hero-label">ESTILISTA DESTACADA DEL AÑO</span>
                    <h2 class="hero-title">@Model.EstilistaTop</h2>
                </div>
                <div class="hero-iconbox"><i class="bi bi-person-circle"></i></div>
            </div>
        </div>
        <div class="col-md-6 reveal d2">
            <div class="hero-card hero-servicio">
                <div>
                    <span class="hero-label">SERVICIO MÁS SOLICITADO</span>
                    <h2 class="hero-title">@Model.ServicioTop</h2>
                </div>
                <div class="hero-iconbox"><i class="bi bi-scissors"></i></div>
            </div>
        </div>
    </div>

    <!-- GRÁFICO + SERVICIOS TOP -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8 reveal d2">
            <div class="card-panel">
                <div class="panel-head">
                    <div>
                        <h5 class="card-title">Citas mensuales</h5>
                        <p class="card-sub">Evolución de servicios durante el año</p>
                    </div>
                    <span class="panel-chip">@Model.AnioSeleccionado</span>
                </div>
                <div style="height: 250px; width: 100%;">
                    <canvas id="graficoBarrasAnual"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4 reveal d3">
            <div class="card-panel">
                <div class="panel-head">
                    <div>
                        <h5 class="card-title">Servicios Top</h5>
                        <p class="card-sub">Los más solicitados</p>
                    </div>
                </div>
                @{ var pos = 1; }
                @foreach(var serv in Model.ServiciosDelMes.Take(4)) {
                    <div class="rank-item">
                        <div class="rank-num">@pos</div>
                        <div class="rank-body">
                            <div class="rank-line">
                                <span>@serv.Nombre</span>
                                <span class="text-muted">@serv.Cantidad (@serv.Porcentaje%)</span>
                            </div>
                            <div class="progress-custom">
                                <div class="progress-bar-custom" style="width: @serv.Porcentaje%;"></div>
                            </div>
                        </div>
                    </div>
                    pos++;
                }
            </div>
        </div>
    </div>

    <!-- HISTORIAL -->
    <div class="card-panel mb-4 reveal d3">
        <div class="panel-head">
            <div>
                <h5 class="card-title">Historial General de Citas y Ingresos</h5>
                <p class="card-sub">Filtra por fechas o por método de pago</p>
            </div>
        </div>

        <div class="row g-3 mb-4 align-items-stretch">
            <div class="col-md-2">
                <div class="filter-card d-flex flex-column justify-content-center">
                    <form method="get" class="d-flex flex-column">
                        <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                        <input type="hidden" name="metodoPago" value="@metodoActual" />
                        <input type="date" name="fechaInicio" value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" class="form-control mb-1" />
                        <input type="date" name="fechaFin" value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" class="form-control mb-2" />
                        <button type="submit" class="btn btn-sm rounded-pill text-white" style="background-color: var(--rose); font-size: 0.75rem;">Filtrar</button>
                    </form>
                </div>
            </div>

            <div class="col-md-2">
                <a href="/AdminReportes/Index?anio=@Model.AnioSeleccionado&fechaInicio=@(Model.FechaInicio?.ToString("yyyy-MM-dd"))&fechaFin=@(Model.FechaFin?.ToString("yyyy-MM-dd"))&metodoPago=Efectivo"
                   class="metric-box box-efectivo @(metodoActual == "Efectivo" ? "active-box" : "")">
                    <div class="metric-title">Efectivo</div>
                    <div class="metric-value">S/ @Model.TotalEfectivo.ToString("F2")</div>
                </a>
            </div>

            <div class="col-md-2">
                <a href="/AdminReportes/Index?anio=@Model.AnioSeleccionado&fechaInicio=@(Model.FechaInicio?.ToString("yyyy-MM-dd"))&fechaFin=@(Model.FechaFin?.ToString("yyyy-MM-dd"))&metodoPago=Tarjeta"
                   class="metric-box box-tarjeta @(metodoActual == "Tarjeta" ? "active-box" : "")">
                    <div class="metric-title">Tarjeta</div>
                    <div class="metric-value">S/ @Model.TotalTarjeta.ToString("F2")</div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="/AdminReportes/Index?anio=@Model.AnioSeleccionado&fechaInicio=@(Model.FechaInicio?.ToString("yyyy-MM-dd"))&fechaFin=@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                   class="metric-box box-total">
                    <div class="metric-title">Calcular Total</div>
                    <div class="metric-value">S/ @Model.GranTotal.ToString("F2")</div>
                </a>
            </div>
            <div class="col-md-3">
                <div class="metric-box box-servicios">
                    <div class="metric-title">Servicios</div>
                    <div class="metric-value">@Model.CantidadServicios</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Método</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(!Model.Transacciones.Any()) {
                                <tr><td colspan="6" class="empty-row"><i class="bi bi-inbox"></i>No hay ingresos para este filtro.</td></tr>
                            } else {
                                @foreach(var t in Model.Transacciones.Take(5)) {
                                    <tr>
                                        <td>@t.FechaTransaccion.ToString("dd/MM/yyyy")</td>
                                        <td class="text-muted">@t.FechaTransaccion.ToString("HH:mm")</td>
                                        <td class="fw-semibold">@t.Cliente</td>
                                        <td>@t.Servicio</td>
                                        <td><span class="badge-metodo @(t.MetodoPago == "Tarjeta" ? "badge-tarjeta" : "")">@t.MetodoPago</span></td>
                                        <td class="text-end fw-bold">S/ @t.Monto.ToString("F2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-4 d-flex flex-column justify-content-center align-items-center">
                <h6 class="fw-bold mb-3 text-muted" style="font-family: 'Playfair Display', serif;">Distribución de Pagos</h6>
                <div class="dona-wrap mb-3">
                    <canvas id="graficoDonaPagos"></canvas>
                    <div class="dona-centro">
                        <small>Total</small>
                        <strong>S/ @Model.GranTotal.ToString("F2")</strong>
                    </div>
                </div>
                <div class="leyenda">
                    <span><i style="background: var(--rose);"></i>Efectivo</span>
                    <span><i style="background: var(--grey);"></i>Tarjeta</span>
                </div>
            </div>
        </div>
    </div>

    <!-- DESEMPEÑO DEL EQUIPO -->
    <div class="card-panel mt-4 reveal d4">
        <div class="panel-head">
            <div>
                <h5 class="card-title">Desempeño del Equipo</h5>
                <p class="card-sub">Servicios realizados e ingresos por estilista</p>
            </div>
            <span class="panel-chip">@Model.AnioSeleccionado</span>
        </div>

        <div class="table-container">
            <table class="table-estilistas">
                <thead>
                    <tr>
                        <th class="sticky">ESTILISTA</th>
                        @foreach(var col in Model.NombresServiciosColumnas) {
                            <th>@col</th>
                        }
                        <th style="color: var(--rose);">TOTAL</th>
                        <th>INGRESOS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var est in Model.TablaEstilistas) {
                        <tr>
                            <td class="sticky">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle">@est.Iniciales</div>
                                    <span class="fw-bold" style="color: #333;">@est.Nombre</span>
                                </div>
                            </td>
                            @foreach(var col in Model.NombresServiciosColumnas) {
                                <td class="num-servicio">
                                    @(est.ServiciosRealizados.ContainsKey(col) && est.ServiciosRealizados[col] > 0 ? est.ServiciosRealizados[col] : "0")
                                </td>
                            }
                            <td class="num-total">@est.Total</td>
                            <td class="num-dinero">S/ @est.Ingresos.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL PARA LA VISTA PREVIA DEL PDF -->
<div class="modal fade" id="modalVistaPrevia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90%;">
        <div class="modal-content" style="border-radius: 14px; border: none; overflow: hidden; background-color: #525659; height: 90vh; box-shadow: 0 20px 50px rgba(0,0,0,.3);">
            <div class="modal-body p-0" id="contenidoVistaPrevia" style="overflow-y: auto; width: 100%; height: 100%;">
            </div>
        </div>
    </div>
</div>
</div> <!-- Fin de .reportes-page -->

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.font.family = "'Montserrat', sans-serif";
        Chart.defaults.color = '#988d91';

        const tooltipEstilo = {
            backgroundColor: '#3d2b1f',
            titleFont: { weight: '600' },
            padding: 10,
            cornerRadius: 8,
            displayColors: false
        };

        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('graficoBarrasAnual').getContext('2d');
            const datosMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiciosPorMes));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
                    datasets: [{
                        label: 'Citas',
                        data: datosMeses,
                        backgroundColor: '#c9a8a1',
                        hoverBackgroundColor: '#b59191',
                        borderRadius: 8,
                        borderSkipped: false,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 900, easing: 'easeOutQuart' },
                    plugins: { legend: { display: false }, tooltip: tooltipEstilo },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f3ebe1', drawBorder: false }, border: { display: false }, ticks: { font: { size: 10 }, precision: 0 } },
                        x: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('graficoDonaPagos').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Efectivo', 'Tarjeta'],
                    datasets: [{
                        data: [@Model.TotalEfectivo, @Model.TotalTarjeta],
                        backgroundColor: ['#c9a8a1', '#cfcaca'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '78%',
                    animation: { animateRotate: true, duration: 1000 },
                    plugins: { legend: { display: false }, tooltip: tooltipEstilo }
                }
            });
        });

        function abrirVistaPrevia() {
            const anio = @Model.AnioSeleccionado;
            fetch(`/AdminReportes/VistaPreviaReporte?anio=${anio}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoVistaPrevia').innerHTML = html;
                    var myModal = new bootstrap.Modal(document.getElementById('modalVistaPrevia'));
                    myModal.show();
                })
                .catch(err => alert("Error al cargar la vista previa."));
        }
    </script>
}