@model HistorialViewModel
@using System.Globalization

@functions {
    static readonly string[] Meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };
    static readonly string[] DiaCorto = { "dom", "lun", "mar", "mié", "jue", "vie", "sáb" };
    static readonly string[] NombresDia = { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };

    const string Svg = "<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">";
    static readonly string IcoReloj = Svg + "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>";
    static readonly string IcoHistorial = Svg + "<path d=\"M3 12a9 9 0 1 0 3-6.7\"/><path d=\"M3 4v5h5\"/><path d=\"M12 8v4l3 2\"/></svg>";
    static readonly string IcoCheck = Svg + "<path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>";
    static readonly string IcoEstrella = Svg + "<path d=\"M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9 6.8 19.7l1-5.9L3.5 9.7l5.9-.8z\"/></svg>";
    static readonly string IcoInfo = Svg + "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\"/></svg>";
    static readonly string IcoX = Svg + "<path d=\"M18 6L6 18M6 6l12 12\"/></svg>";

    static string Iniciales(string? nombre)
    {
        var partes = (nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
        return s.Length == 0 ? "?" : s;
    }

    static string Estrellas(int n) =>
        "<span class=\"dk-stars\" aria-label=\"" + n + " de 5 estrellas\">" +
        "<span class=\"dk-stars__on\">" + new string('★', n) + "</span>" +
        "<span class=\"dk-stars__off\">" + new string('★', 5 - n) + "</span></span>";

    static string Precio(decimal p) => "S/ " + p.ToString("N2", CultureInfo.InvariantCulture);
    static int Minutos(DateTime a, DateTime b) => (int)(b - a).TotalMinutes;
}

@{
    ViewData["Title"] = "Historial";
    var nombre = (User.Identity?.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    var grupos = Model.Items
        .GroupBy(i => new { i.Inicio.Year, i.Inicio.Month })
        .ToList();
}

<section class="dk-mc dk-hi">
    <div class="dk-mc__card">

        <div class="dk-mc__band">
            <div class="dk-mc__bandtxt">
                <span class="dk-mc__hola">Hola, @nombre</span>
                <h1 class="dk-mc__title">Historial</h1>
            </div>
            <div class="dk-mc__bandico">@Html.Raw(IcoHistorial)</div>
        </div>

        <div class="dk-mc__body">

            @if (Model.Items.Count == 0)
            {
                <div class="dk-mc__vacio">
                    <div class="dk-mc__vacio-ico">@Html.Raw(IcoHistorial)</div>
                    <h2>Aún no tienes servicios en tu historial</h2>
                    <p>Cuando asistas a una cita, aparecerá aquí y podrás calificarla.</p>
                    <a class="dk-mc__btn dk-mc__btn--main" href="/cuenta/mis-citas">Ver mis citas</a>
                </div>
            }
            else
            {
                <div class="dk-hi__stats">
                    <div class="dk-hi__stat">
                        <span class="dk-hi__statico">@Html.Raw(IcoCheck)</span>
                        <div><b>@Model.Completadas</b><span>@(Model.Completadas == 1 ? "visita completada" : "visitas completadas")</span></div>
                    </div>
                    <div class="dk-hi__stat dk-hi__stat--pen">
                        <span class="dk-hi__statico">@Html.Raw(IcoEstrella)</span>
                        <div><b>@Model.PorCalificar</b><span>por calificar</span></div>
                    </div>
                </div>

                <div class="dk-hi__regla">
                    <span class="dk-hi__reglaico">@Html.Raw(IcoInfo)</span>
                    <p>Solo puedes calificar los servicios a los que asististe (citas completadas), y una sola vez por cita.</p>
                </div>

                <div class="dk-hi__filtros" role="group" aria-label="Filtrar historial">
                    <button type="button" class="is-on" data-f="todas">Todas <em>@Model.Items.Count</em></button>
                    <button type="button" data-f="por">Por calificar <em>@Model.PorCalificar</em></button>
                    <button type="button" data-f="rat">Calificadas <em>@Model.Calificadas</em></button>
                    <button type="button" data-f="can">Canceladas <em>@Model.Canceladas</em></button>
                </div>

                @foreach (var g in grupos)
                {
                    <div class="dk-hi__grupo">
                        <h2 class="dk-hi__mes">@Meses[g.Key.Month - 1] @g.Key.Year</h2>

                        @foreach (var i in g)
                        {
                            <article class="dk-hi__fila dk-hi__fila--@i.Clase" data-c="@i.Clase">
                                <div class="dk-hi__fecha">
                                    <b>@i.Inicio.ToString("dd")</b>
                                    <small>@DiaCorto[(int)i.Inicio.DayOfWeek]</small>
                                </div>

                                <div class="dk-hi__info">
                                    <h3>@i.Servicio</h3>
                                    <div class="dk-hi__meta">
                                        <span>
                                            <i class="dk-hi__av">
                                                @if (i.EstilistaTieneFoto)
                                                {
                                                    <img src="/media/estilistas/@i.EstilistaId" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    @Iniciales(i.Estilista)
                                                }
                                            </i>
                                            @i.Estilista
                                        </span>
                                        <span>@Html.Raw(IcoReloj) @i.Inicio.ToString("HH:mm") · @Minutos(i.Inicio, i.Fin) min</span>
                                        <span class="dk-hi__precio">@Precio(i.Precio)</span>
                                    </div>

                                    <div class="dk-hi__chips">
                                        @if (i.Clase == "can")
                                        {
                                            <span class="dk-hi__chip dk-hi__chip--can">@Html.Raw(IcoX) Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="dk-hi__chip dk-hi__chip--ok">@Html.Raw(IcoCheck) Asististe</span>
                                            if (i.Clase == "por")
                                            {
                                                <span class="dk-hi__chip dk-hi__chip--pen">Por calificar</span>
                                            }
                                            else
                                            {
                                                <span class="dk-hi__chip dk-hi__chip--rat">Calificada</span>
                                            }
                                        }
                                    </div>

                                    @if (i.Clase == "rat" && !string.IsNullOrWhiteSpace(i.Comentario))
                                    {
                                        <p class="dk-hi__rv">“@i.Comentario”</p>
                                    }
                                    @if (i.Clase == "can")
                                    {
                                        <p class="dk-hi__nota">No asististe a esta cita, por eso no se puede calificar.</p>
                                    }
                                </div>

                                <div class="dk-hi__acc">
                                    @if (i.Clase == "por")
                                    {
                                        <a class="dk-mc__btn dk-mc__btn--main dk-hi__btn" href="/cuenta/historial/@i.Id/calificar">@Html.Raw(IcoEstrella) Calificar</a>
                                    }
                                    else if (i.Clase == "rat" && i.Estrellas is int e)
                                    {
                                        @Html.Raw(Estrellas(e))
                                        <small>Tu calificación</small>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }

                <p class="dk-hi__vacio-filtro" hidden>No hay citas en esta categoría.</p>
            }
        </div>
    </div>
</section>

<script>
    (function () {
        var botones = document.querySelectorAll('.dk-hi__filtros button');
        var filas = document.querySelectorAll('.dk-hi__fila');
        var grupos = document.querySelectorAll('.dk-hi__grupo');
        var vacio = document.querySelector('.dk-hi__vacio-filtro');
        if (!botones.length) return;

        function aplicar(f) {
            botones.forEach(function (b) { b.classList.toggle('is-on', b.getAttribute('data-f') === f); });
            filas.forEach(function (r) {
                r.hidden = !(f === 'todas' || r.getAttribute('data-c') === f);
            });
            var algo = false;
            grupos.forEach(function (g) {
                var visible = g.querySelector('.dk-hi__fila:not([hidden])') !== null;
                g.hidden = !visible;
                if (visible) algo = true;
            });
            if (vacio) vacio.hidden = algo;
        }

        botones.forEach(function (b) {
            b.addEventListener('click', function () { aplicar(b.getAttribute('data-f')); });
        });
    })();
</script>