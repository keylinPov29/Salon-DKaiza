@model ClienteDetalleViewModel

@functions {
    static readonly string[] MesesCorto = { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic" };

    const string Svg = "<svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">";
    static readonly string IcoTel = Svg + "<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z\"/></svg>";
    static readonly string IcoMail = Svg + "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><path d=\"M3 7l9 6 9-6\"/></svg>";
    static readonly string IcoCalendario = Svg + "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M8 3v4M16 3v4M3 11h18\"/></svg>";
    static readonly string IcoReloj = Svg + "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>";
    static readonly string IcoAtras = Svg + "<path d=\"M15 18l-6-6 6-6\"/></svg>";
    static readonly string IcoNota = Svg + "<path d=\"M6 3h9l4 4v14H6z\"/><path d=\"M15 3v4h4M9 12h7M9 16h5\"/></svg>";

    static string Iniciales(string? nombre)
    {
        var partes = (nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
        return s.Length == 0 ? "?" : s;
    }

    static string Fecha(DateTime d) => $"{d.Day} {MesesCorto[d.Month - 1]} {d.Year}";
    static string FechaHora(DateTime d) => $"{d.Day} {MesesCorto[d.Month - 1]} {d.Year}, {d:HH:mm}";
}

@{
    ViewData["Title"] = Model.Nombre;
    var q = Model.VolverQ ?? "";
    var qUrl = Uri.EscapeDataString(q);
    var volver = q.Length > 0 ? $"/clientes?q={qUrl}" : "/clientes";
    var maxVeces = Model.Preferencias.Count == 0 ? 0 : Model.Preferencias.Max(p => p.Veces);
}

<section class="dk-mc dk-cl">
    <div class="dk-mc__card dk-cl__card">

        <div class="dk-mc__body dk-cl__ficha">

            <a class="dk-cl__volver" href="@volver">@Html.Raw(IcoAtras) Volver a los resultados</a>

            <article class="dk-mc__hero dk-cl__hero">
                <div class="dk-mc__herotop">
                    <span class="dk-mc__kicker">Ficha de atención</span>
                </div>

                <div class="dk-mc__heromain">
                    <i class="dk-cl__avgrande">@Iniciales(Model.Nombre)</i>
                    <div class="dk-mc__heroinfo">
                        <h1 class="dk-mc__herosv">@Model.Nombre</h1>
                        <div class="dk-mc__herometa">
                            <span>@Html.Raw(IcoTel) @Model.Telefono</span>
                            <span>@Html.Raw(IcoMail) @Model.Email</span>
                            <span>@Html.Raw(IcoCalendario) Cliente desde @(MesesCorto[Model.ClienteDesde.Month - 1]) @Model.ClienteDesde.Year</span>
                        </div>
                    </div>
                </div>

                <div class="dk-mc__herofoot dk-cl__kps">
                    <div class="dk-cl__kp"><b>@Model.Visitas</b><span>Visitas</span></div>
                    <div class="dk-cl__kp">
                        <b>@(Model.UltimaVisita == null ? "—" : $"{Model.UltimaVisita.Value.Day} {MesesCorto[Model.UltimaVisita.Value.Month - 1]}")</b>
                        <span>Última visita</span>
                    </div>
                    <div class="dk-cl__kp"><b>@Model.TotalNotas</b><span>Notas</span></div>
                </div>
            </article>

            <div class="dk-cl__cols">

                <aside class="dk-cl__lado">

                    <div class="dk-cl__caja">
                        <h2>Preferencias</h2>
                        <p class="dk-cl__sub">Lo que más pide</p>

                        @if (Model.Preferencias.Count == 0)
                        {
                            <p class="dk-cl__vacio">Aún no tiene servicios completados.</p>
                        }
                        else
                        {
                            foreach (var p in Model.Preferencias)
                            {
                                var pct = maxVeces == 0 ? 0 : (int)Math.Round(100.0 * p.Veces / maxVeces);
                                <div class="dk-cl__pb">
                                    <div class="dk-cl__pbl"><span>@p.Servicio</span><b>@p.Veces</b></div>
                                    <span class="dk-cl__barra dk-cl__barra--g"><i style="width:@(pct)%"></i></span>
                                </div>
                            }
                            <p class="dk-cl__auto">Se actualizan solas según sus servicios más solicitados.</p>
                        }
                    </div>

                    <div class="dk-cl__caja">
                        <h2>Notas</h2>
                        <p class="dk-cl__sub">Observaciones para atenderla mejor</p>

                        <form asp-controller="Clientes" asp-action="AgregarNota" asp-route-id="@Model.Id" method="post" class="dk-cl__formnota">
                            <input type="hidden" name="q" value="@q" />
                            <textarea name="texto" id="dkNotaTexto" maxlength="500" rows="3" required
                                      placeholder="Escribe una observación sobre el cliente…"></textarea>
                            <div class="dk-cl__nota-pie">
                                <button type="submit" class="dk-mc__btn dk-mc__btn--main dk-mc__btn--sm">@Html.Raw(IcoNota) Agregar nota</button>
                                <span class="dk-cl__cont" id="dkNotaCont">0 / 500</span>
                            </div>
                        </form>

                        @if (Model.Notas.Count == 0)
                        {
                            <p class="dk-cl__vacio">Todavía no hay notas para este cliente.</p>
                        }
                        else
                        {
                            foreach (var n in Model.Notas)
                            {
                                <div class="dk-cl__nota">
                                    <p>@n.Texto</p>
                                    <div class="dk-cl__por">
                                        <i class="dk-mc__av dk-mc__av--claro">@Iniciales(n.Autor)</i>
                                        <span><b>@n.Autor</b> · @FechaHora(n.Fecha)</span>
                                    </div>
                                </div>
                            }
                            if (Model.TotalNotas > Model.Notas.Count)
                            {
                                <p class="dk-cl__auto">Mostrando las @Model.Notas.Count notas más recientes de @Model.TotalNotas.</p>
                            }
                        }
                    </div>
                </aside>

                <section class="dk-cl__hist">
                    <div class="dk-cl__histtop">
                        <h2>Historial de citas</h2>
                        <span>Más reciente primero</span>
                    </div>

                    @if (Model.Historial.Count == 0)
                    {
                        <div class="dk-cl__caja"><p class="dk-cl__vacio">Este cliente aún no tiene citas.</p></div>
                    }
                    else
                    {
                        foreach (var h in Model.Historial)
                        {
                            <article class="dk-cl__cita dk-cl__cita--@h.EstadoClase">
                                <div class="dk-cl__dia">
                                    <b>@h.Inicio.Day</b>
                                    <small>@MesesCorto[h.Inicio.Month - 1]</small>
                                </div>
                                <div class="dk-cl__cinfo">
                                    <h3>@h.Servicio</h3>
                                    <div class="dk-cl__cmeta">
                                        <span>@h.Estilista</span>
                                        <span>@Html.Raw(IcoReloj) @h.Inicio.ToString("HH:mm") · @h.Inicio.Year</span>
                                    </div>
                                </div>
                                <span class="dk-cl__est dk-cl__est--@h.EstadoClase">@h.EstadoTexto</span>
                            </article>
                        }

                        if (Model.TotalPaginas > 1)
                        {
                            <nav class="dk-cl__pag dk-cl__pag--centro" aria-label="Páginas del historial">
                                @for (var p = 1; p <= Model.TotalPaginas; p++)
                                {
                                    <a href="/clientes/@(Model.Id)?pagina=@p&q=@qUrl" class="@(p == Model.Pagina ? "is-on" : "")">@p</a>
                                }
                            </nav>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var t = document.getElementById('dkNotaTexto');
        var c = document.getElementById('dkNotaCont');
        if (!t || !c) return;
        t.addEventListener('input', function () { c.textContent = t.value.length + ' / 500'; });
    })();
</script>