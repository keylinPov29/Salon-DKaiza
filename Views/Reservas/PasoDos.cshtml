@model DKaiza.Web.Models.ReservaPasoDosViewModel
@{
    ViewData["Title"] = "Elegir estilista";
    var fechaDisplay = Model.Fecha.ToString("dddd d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-PE"));
    fechaDisplay = char.ToUpper(fechaDisplay[0]) + fechaDisplay[1..];
}

<section class="dk-reserva">
    <div class="dk-container">

        <!-- Progreso -->
        <div class="dk-steps">
            <div class="dk-step dk-step--done">
                <span class="dk-step__num">✓</span>
                <span class="dk-step__label">Fecha</span>
            </div>
            <div class="dk-step__line dk-step__line--done"></div>
            <div class="dk-step dk-step--active">
                <span class="dk-step__num">2</span>
                <span class="dk-step__label">Estilista</span>
            </div>
            <div class="dk-step__line"></div>
            <div class="dk-step">
                <span class="dk-step__num">3</span>
                <span class="dk-step__label">Hora</span>
            </div>
            <div class="dk-step__line"></div>
            <div class="dk-step">
                <span class="dk-step__num">4</span>
                <span class="dk-step__label">Confirmar</span>
            </div>
        </div>

        <!-- Cabecera -->
        <div class="dk-reserva__head">
            <a href="/reservas/nueva?servicioId=@Model.ServicioId" class="dk-back">&larr; Cambiar fecha</a>
            <div class="dk-reserva__servicio">
                <span class="dk-reserva__eyebrow">— @Model.ServicioNombre —</span>
                <h1 class="dk-reserva__titulo">Elige tu estilista</h1>
                <p class="dk-reserva__fecha-chip">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    @fechaDisplay
                </p>
            </div>
        </div>

        <!-- Lista de estilistas -->
        @if (!Model.Estilistas.Any())
        {
            <div class="dk-empty">
                <span class="dk-empty__icon">✦</span>
                <h3 class="dk-empty__title">Sin disponibilidad</h3>
                <p class="dk-empty__text">No hay estilistas disponibles ese día. Por favor elige otra fecha.</p>
                <a href="/reservas/nueva?servicioId=@Model.ServicioId" class="dk-btn dk-btn--primary">Ver otras fechas</a>
            </div>
        }
        else
        {
            <div class="dk-estilistas-grid">
                @foreach (var e in Model.Estilistas)
                {
                    <a class="dk-estilista-card"
                       href="/reservas/horarios?servicioId=@Model.ServicioId&fecha=@Model.Fecha.ToString("yyyy-MM-dd")&estilistaId=@e.Id">

                        <div class="dk-estilista-card__avatar">
                            @if (e.TieneFoto)
                            {
                                <img src="/media/estilistas/@e.Id" alt="@e.NombreCompleto" />
                            }
                            else
                            {
                                <span class="dk-estilista-card__initials">
                                    @(string.Concat(e.NombreCompleto.Split(' ')
                                        .Where(w => w.Length > 0).Take(2)
                                        .Select(w => w[0].ToString().ToUpper())))
                                </span>
                            }
                        </div>

                        <div class="dk-estilista-card__info">
                            <strong class="dk-estilista-card__nombre">@e.NombreCompleto</strong>
                            <span class="dk-estilista-card__espec">@e.Especialidad</span>
                            <span class="dk-estilista-card__slots">
                                @e.HorariosLibres horario@(e.HorariosLibres == 1 ? "" : "s") disponible@(e.HorariosLibres == 1 ? "" : "s")
                            </span>
                        </div>

                        <svg class="dk-estilista-card__arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                        </svg>
                    </a>
                }
            </div>
        }

    </div>
</section>
